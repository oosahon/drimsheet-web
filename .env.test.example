# pl-web E2E test environment
# This file is NOT committed (see .gitignore).
# Copy from .env.test.example and fill in real values.

# Web app base URL (must match playwright.config.ts webServer url)
VITE_API_URL=http://localhost:3001

# Mailinator API token (optional - leave empty for free public inboxes)
# Get a token at https://www.mailinator.com/settings
MAILINATOR_API_TOKEN=
